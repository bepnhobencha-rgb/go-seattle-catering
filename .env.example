# ===== Database (Vercel Postgres) =====
# Vercel Postgres auto-injects these via integration. For local dev:
#   1. Connect Vercel to your project (vercel link)
#   2. Pull env: vercel env pull .env.local
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""

# ===== NextAuth =====
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Local dev: http://localhost:3000  ·  Production: https://yourdomain.com
NEXTAUTH_URL="http://localhost:3000"

# ===== File uploads (Vercel Blob) =====
# Vercel Blob auto-injects this via integration. Leave blank in local dev to fall
# back to local /public/images/uploads/ writes.
BLOB_READ_WRITE_TOKEN=""
